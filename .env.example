# =====================================================================
# UDYOGSETU (उद्योगसेतू) INDUSTRIAL RECRUITMENT PLATFORM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Geographic Focus: Chakan MIDC, Khed City, Kuruli, Pune Belt
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (CLIENT-SAFE)
# ---------------------------------------------------------------------
# Your Supabase Project API URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Publishable Key (Dashboard -> Project Settings -> API)
# Safe for client-side browser usage protected by Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# ---------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (PRIVILEGED SERVER-ONLY)
# ---------------------------------------------------------------------
# WARNING: NEVER expose this key to browser client or check into public Git.
# Used strictly in /pages/api/ routes for administrative provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ---------------------------------------------------------------------
# 3. ADMINISTRATIVE SECURITY SECRETS
# ---------------------------------------------------------------------
# Secret required to call POST /api/admin/provision with 'x-admin-secret'
ADMIN_PROVISION_SECRET=your-random-32-char-secure-secret-key-here

# Secret required to authorize scheduled cron executions (/api/cron/freshness-and-risk)
CRON_SECRET=your-random-32-char-cron-secret-key-here

# ---------------------------------------------------------------------
# 4. SMS GATEWAY CONFIGURATION NOTICE (MOBILE OTP AUTHENTICATION)
# ---------------------------------------------------------------------
# To enable real SMS OTP login for factory workers, configure your SMS
# provider (Twilio, MSG91, or Textlocal) directly inside the Supabase Dashboard:
# 1. Navigate to: Authentication -> Providers -> Phone
# 2. Enable "Phone Provider"
# 3. Select your SMS Gateway (e.g. Twilio / MessageBird)
# 4. Provide your SMS provider Account SID, Auth Token & DLT-approved Sender ID
# If not configured, UdyogSetu seamlessly operates in Email+Password auth mode.
